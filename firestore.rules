rules_version = '2';

// Public can read site content. Only the admin can write it.
// The admin is whoever has a document at admins/{uid} (created by hand in the Firebase console).
// Limits mirror services/content/validation.ts. The rules language has no loops,
// so items inside lists are checked by the app (zod on save, sanitizeUrl on render).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isText(value, max) {
      return value is string && value.size() <= max;
    }

    function isRequiredText(value, max) {
      return isText(value, max) && value.size() > 0;
    }

    function isListOf(value, max) {
      return value is list && value.size() <= max;
    }

    function isSong(song) {
      return song is map
        && song.keys().hasOnly(['title', 'artist', 'youtubeId'])
        && song.keys().hasAll(['title', 'artist', 'youtubeId'])
        && isText(song.title, 120)
        && isText(song.artist, 120)
        && song.youtubeId is string
        && song.youtubeId.matches('^([A-Za-z0-9_-]{11})?$');
    }

    function isProfile(data) {
      let keys = ['name', 'shortName', 'location', 'timezone', 'availability', 'intro', 'interests', 'contacts', 'song'];
      return data.keys().hasOnly(keys)
        && data.keys().hasAll(keys)
        && isRequiredText(data.name, 120)
        && isRequiredText(data.shortName, 120)
        && isText(data.location, 120)
        && isText(data.timezone, 120)
        && isText(data.availability, 120)
        && isText(data.intro, 400)
        && isListOf(data.interests, 20)
        && isListOf(data.contacts, 10)
        && isSong(data.song);
    }

    function isItemsDoc(data, max) {
      return data.keys().hasOnly(['items'])
        && data.keys().hasAll(['items'])
        && isListOf(data.items, max);
    }

    function isValidSection(section, data) {
      return (section == 'profile' && isProfile(data))
        || (section == 'education' && isItemsDoc(data, 20))
        || (section == 'projects' && isItemsDoc(data, 50))
        || (section == 'posts' && isItemsDoc(data, 100));
    }

    match /content/{section} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidSection(section, request.resource.data);
      allow delete: if false;
    }

    // Like counts: anyone can read them and add exactly 1 (visitors may like as often as they want).
    // Nobody can set a count directly, lower it, add other fields, or delete it.
    match /likes/{likeId} {
      allow get: if true;
      allow list: if false;
      allow create: if likeId.matches('^(project|post)-[a-z0-9-]{1,64}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /admins/{uid} {
      // A signed-in user may only check whether they themselves are an admin.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Everything else is denied by default.
  }
}
