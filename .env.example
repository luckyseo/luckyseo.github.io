# Copy to .env.local (never commit .env.local).
# Values come from Firebase console -> Project settings -> Your apps -> Web app.
# For the GitHub Pages build, add the same names as repository secrets.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase App Check (reCAPTCHA v3 site key)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Optional: App Check debug token for localhost (Firebase console -> App Check -> Manage debug tokens)
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
